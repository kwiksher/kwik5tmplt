settings = {
    plugins = {
        ["plugin.zip"] = {
            publisherId = "com.coronalabs",
        },
        ["plugin.tinyfiledialogs"] = {
            publisherId = "com.xibalbastudios"
        },
        ["plugin.nanosvg"] = {
            publisherId = "com.coronalabs"
        },
    },
    orientation = {
        default = "landscapeRight",
        supported = {
            "portrait", "portraitUpsideDown",
        },
    },
    splashScreen = {
        enable = true,
        image = "mySplashScreen.png",
    },
    android = {
        minSdkVersion = "21",
        usesPermissions = {
            "android.permission.READ_EXTERNAL_STORAGE",
            "android.permission.WRITE_EXTERNAL_STORAGE",
            "android.permission.READ_MEDIA_IMAGES",
        },
        useFeatures = {
        }
    },
    iphone = {
        xcassets = "Images.xcassets",
        plist = {
            NSAppTransportSecurity = {
                NSExceptionDomains = {
                }
            },
            UIStatusBarHidden = true,
            UILaunchStoryboardName = "LaunchScreen",
            CFBundleLocalizations = {},
            CFBundleDisplayName = "BehaviorTest",
            CFBundleName = "BehaviorTest",
        },
    },
    window = {
        defaultMode = "fullscreen",
        defaultViewWidth = 1280,
        defaultViewHeight = 720,
        resizable = true,
        minViewWidth = 640,
        minViewHeight = 360,
        enableMaximizeButton = true,
    },
    win32 = {
        preferenceStorage = "sqlite",
        singleInstance = false
    },
    osx = {
        entitlements = {
            ["com.apple.security.assets.pictures.read-write"] = true,
        },
    },
    excludeFiles = {
        all = {"Icon*.png", "Images.xcassets", "Icon*.ico", "Icon*.icns", "*.vbs", "*.bat", "*.command", "copy_projects", "lua_modules/kwiksher/resources/template/*"},
        android = {"LaunchScreen.storyboardc"},
        win32 = {"LaunchScreen.storyboardc"},
    },
}
